DB_URL=postgresql+asyncpg://postgres:postgrespw@localhost:5432
DEPLOY_ENVIRONMENT=LOCAL
AUTH_ALGORITHM=HS256
AUTH_SECRET_KEY=secretkey
SQL_ADMIN_USERNAME=admin
SQL_ADMIN_PASSWORD=adminpassword
SQL_ADMIN_SECRET_KEY=pwsdsmkljvsbhjgufuasdfiuasdkobnoirgbnudfbSDAFADSKJsdappp
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
NEO4J_DB_URL=neo4j://localhost:7687
NEO4J_DB_USERNAME=neo4j
NEO4J_DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
# Nostr relay wiring. FROM = external source of events to sync in. TO = local
# neofry relay; TA events publish to the local strfry relay (one-click stack
# host ports 7777 / 7778). The PUBLIC_URL is embedded in published TA events —
# point it at the relay's externally reachable address in prod.
NOSTR_TRANSFER_FROM_RELAY=wss://wot.grapevine.network
NOSTR_TRANSFER_TO_RELAY=ws://localhost:7777
NOSTR_UPLOAD_TA_EVENTS_RELAY=ws://localhost:7778
NOSTR_UPLOAD_TA_EVENTS_RELAY_PUBLIC_URL=ws://localhost:7778
# True runs the initial full relay -> graph sync at startup and blocks the app
# until it finishes. Enable for first-time bootstrap; false for day-to-day dev.
PERFORM_NOSTR_FULL_SYNC=false
FRONTEND_URL=http://localhost:3000
# This server's own externally visible base URL (NIP-98 / NWT audience checks).
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_ENABLED=false
ADMIN_WHITELISTED_PUBKEYS=
STALE_ONGOING_BRAINSTORM_REQUEST_THRESHOLD_HOURS=7
STALE_ONGOING_BRAINSTORM_REQUEST_CHECK_INTERVAL_MINUTES=30
BLOCK_FREQUENT_GRAPERANK_REQUESTS=false
BLOCK_FREQUENT_GRAPERANK_REQUESTS_MINUTES=30
# Write-side gate: scorecards below this influence are neither published as TA
# events nor mirrored into Vespa. 0.02 = deployed staging/local value (tests use 0.05).
CUTOFF_OF_VALID_GRAPERANK_SCORES=0.02
# Global kill-switch for the scheduler. Default off; enable per environment.
SCHEDULER_ENABLED=false
# Max scheduled runs publishing before the scheduler pauses admission.
SCHEDULER_INFLIGHT_TARGET=1
# Priority-weighted admission (w=priority+1). Off = strict highest-first.
SCHEDULER_FAIRNESS_ENABLED=false
PERIODIC_GRAPERANK_PUBKEY=
VESPA_URL=http://localhost:8080
# Per-sink publish mode: false (default) = only changed scores; true = re-assert
# every above-cutoff score each run. Re-assertion only, not deletes.
VESPA_FULL_SYNC=false
RELAY_FULL_SYNC=false
# Per-sink orphan reaping: also delete EVERY below-cutoff Observee, not just the
# ones that fell off the baseline. On to drain a backlog, then off.
RELAY_SWEEP_BELOW_CUTOFF=false
VESPA_SWEEP_BELOW_CUTOFF=false
# Count-gated parallel signing. Runs signing <= threshold events via the simple
# sequential client loop (the common steady-state case, zero pool overhead);
# above it a large burst (first publish for an Observer, big graph shift) shards
# signing across a ProcessPoolExecutor (both ~10× faster and off the event loop).
# SIGN_PARALLEL_MAX_WORKERS defaults to os.cpu_count(); uncomment to override.
SIGN_PARALLEL_THRESHOLD=10000
# SIGN_PARALLEL_MAX_WORKERS=12
# Drift backstop: every Nth scheduled run per observer forces a full re-assert on
# both sinks. Cadence is 2h, so 84 ≈ weekly. <= 0 disables it.
FULL_SYNC_EVERY_N_RUNS=84
# Optional Vespa feed tuning (plain os.getenv in app/core/vespa.py; sane defaults,
# only set to override). Concurrency = simultaneous connections (the endpoint is
# HTTP/1.1 — no multiplexing); connect-level failures are retried; HTTP/2 is a
# no-op over cleartext (httpx negotiates h2 only via ALPN over TLS).
#VESPA_FEED_CONCURRENCY=32
#VESPA_CONNECT_RETRIES=3
#VESPA_HTTP2=true
# Large batches (>= 5000 ops) are fed by the official JVM vespa-feed-client
# subprocess (~2.5x the httpx path) — AUTO-ENABLED when the JAR below exists (the
# image ships a JRE + the JAR; see Dockerfile). Falls back to httpx on any error.
# The live-profile trickle always stays on the httpx path.
#VESPA_FEEDER_JAR=/opt/vespa-feed-client.jar
#VESPA_FEEDER_CONNECTIONS=            # blank = feed-client auto-tunes
# Open Ranking auth posture. false = open/unauthenticated (uses the public
# global observer + client-supplied pov). true = require a valid NWT and force
# every query to the signer's own observer perspective (pov is ignored).
OPEN_RANKING_REQUIRE_AUTH=false

# --- Trusted Lists (kind-30392 from kind-39999 taggings) --------------------
# Inclusive floor on an asserter's Rank (0-100) in the Observer's own web of
# trust before their Tagging counts. Default 3 == issue #73's "rank > 2".
#TRUSTED_LIST_MIN_RANK=3
# Distinct qualifying asserters a Tag needs before it enters the dictionary.
#TRUSTED_LIST_MIN_TAG_USES=1
# Membership floor: a target needs applications >= cutoff (and > disputes).
#TRUSTED_LIST_CUTOFF=1
# Where Trusted Lists publish. Blank = the TA relay
# (NOSTR_UPLOAD_TA_EVENTS_RELAY). Point at the nip85.* relays to mirror there.
#TRUSTED_LIST_RELAY=
